---
import { getLotesVenta, formatSuperficie } from '../lib/propiedades';

const lotesVenta = await getLotesVenta();

const formatPrecio = (precio: {valor: number, moneda: string}) => {
  if (!precio.valor) return 'Consultar';
  return `${precio.moneda} ${precio.valor.toLocaleString('es-AR')}`;
};
---

<section id="ventas-lotes" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <span class="section-label text-nav-red font-light text-lg uppercase tracking-wider">
        Ventas
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-nav-dark mt-4 mb-6">
        Lotes y Terrenos en Venta
      </h2>
      <p class="text-lg text-nav-gray max-w-2xl">
        Terrenos ideales para construir tu casa o desarrollar proyectos en San Pedro y alrededores.
      </p>
    </div>

    {lotesVenta.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-nav-gray text-lg">No hay lotes en venta disponibles en este momento.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {lotesVenta.map((propiedad) => (
          <article class="property-card group" data-property-id={propiedad.id}>
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={propiedad.fotos[0]}
                alt={propiedad.titulo}
                class="w-full h-full object-cover group-hover:scale-110 group-active:scale-110 transition-transform duration-500"
                loading="lazy"
              />
              <span class="property-badge badge-venta-nav">Venta</span>
              <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-lg">
                <span class="text-lg font-bold text-nav-dark">{formatPrecio(propiedad.precio)}</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="property-title-nav">{propiedad.titulo}</h3>
              <p class="text-nav-gray flex items-center gap-2 mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {propiedad.direccion.calle ? `${propiedad.direccion.calle}, ` : ''}{propiedad.direccion.ciudad}
              </p>
              {propiedad.descripcion_corta && (
                <p class="text-nav-gray text-sm mb-4 line-clamp-2">{propiedad.descripcion_corta}</p>
              )}
              <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
                {propiedad.caracteristicas.superficie_total && (
                  <div class="flex items-center gap-1 text-sm text-nav-gray">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                    </svg>
                    <span>{formatSuperficie(propiedad.caracteristicas.superficie_total, propiedad.caracteristicas.superficie_unidad)}</span>
                  </div>
                )}
                <button
                  class="property-link-nav ver-detalle-btn"
                  data-property={JSON.stringify(propiedad)}
                >
                  <span>Ver más</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
