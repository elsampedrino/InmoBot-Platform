---
import { getEmpresa, getContacto, getFooter, getTelefonoUrl, getEmailUrl } from '../lib/config';

const empresa = getEmpresa();
const contacto = getContacto();
const footer = getFooter();
const currentYear = new Date().getFullYear();
---

<footer class="bg-nav-dark text-white">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-5">

      <!-- Logo + Text -->
      <div class="flex flex-col md:flex-row items-center gap-3 md:gap-4">
        <img
          src={empresa.logo}
          alt={empresa.nombre}
          class="h-14 w-auto"
          style="filter: brightness(0) invert(1);"
        />
        <div class="hidden md:block w-1.5 h-14 bg-white/30 rounded-full"></div>
        <div class="md:hidden w-20 h-0.5 bg-white/30 rounded-full"></div>
        <p class="text-white/80 text-center md:text-left max-w-xs text-sm">
          {footer.descripcion}
        </p>
      </div>

      <!-- Contact Info -->
      <div class="flex flex-col md:flex-row items-center gap-3 md:gap-4">
        <h4 class="text-base font-light uppercase tracking-wider">{contacto.titulo_seccion}</h4>
        <div class="hidden md:block w-1.5 h-16 bg-white/30 rounded-full"></div>
        <div class="md:hidden w-20 h-0.5 bg-white/30 rounded-full"></div>
        <div class="flex flex-col items-center md:items-start gap-2">
          <a href={getTelefonoUrl()} class="flex items-center gap-2 footer-link-nav">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #CC1010;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>{contacto.telefono.display}</span>
          </a>
          <a href={getEmailUrl()} class="flex items-center gap-2 footer-link-nav">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #CC1010;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="text-sm">{contacto.email}</span>
          </a>
          <div class="flex items-center gap-2 text-white/70">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #CC1010;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm">{contacto.direccion}</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10" style="background-color: #FFCC33;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-col md:flex-row justify-between items-center gap-2">
        <p class="text-[#1a1a2e] text-sm font-medium text-center md:text-left">
          &copy; {currentYear} {empresa.nombre}. Todos los derechos reservados.
        </p>
        <p class="text-[#1a1a2e] text-sm font-medium">
          Desarrollado por <a href={footer.desarrollado_por.link} class="text-[#CC1010] hover:underline font-semibold">{footer.desarrollado_por.nombre}</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .footer-link-nav {
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.2s;
  }

  .footer-link-nav:hover {
    color: #CC1010;
  }
</style>
