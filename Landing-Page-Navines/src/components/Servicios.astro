---
import { getServicios } from '../lib/config';

const serviciosConfig = getServicios();

const iconos: Record<string, string> = {
  home: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
  </svg>`,
  money: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
  </svg>`,
  document: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
  </svg>`,
  calculator: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
  </svg>`,
  users: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
  </svg>`,
  building: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
  </svg>`,
  key: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
  </svg>`
};
---

<section id="servicios" class="py-20" style="background-color: #1a1a2e;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16">
      <span class="section-label-yellow font-light text-lg uppercase tracking-wider">
        {serviciosConfig.titulo_seccion}
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mt-4 mb-6">
        {serviciosConfig.subtitulo}
      </h2>
      <p class="text-lg max-w-2xl" style="color: rgba(255,255,255,0.55);">
        {serviciosConfig.descripcion}
      </p>
    </div>

    <div id="servicios-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {serviciosConfig.lista.map((servicio) => (
        <div class="svc-card group">
          <div class="svc-icon mb-6">
            <Fragment set:html={iconos[servicio.icono] || iconos.key} />
          </div>
          <h3 class="text-xl font-bold text-white mb-4">{servicio.titulo}</h3>
          <p class="leading-relaxed" style="color: rgba(255,255,255,0.55);">{servicio.descripcion}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const grid = document.getElementById('servicios-grid');
  if (grid) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cards = grid.querySelectorAll<HTMLElement>('.svc-card');
          cards.forEach((card, i) => {
            setTimeout(() => card.classList.add('svc-visible'), i * 110);
          });
          observer.unobserve(grid);
        }
      });
    }, { threshold: 0.1 });
    observer.observe(grid);
  }
</script>

<style is:global>
  .section-label-yellow {
    display: inline-block;
    position: relative;
    padding-bottom: 10px;
    color: #FFCC33;
  }

  .section-label-yellow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: -100vw;
    right: 0;
    height: 2px;
    background-color: #FFCC33;
    box-shadow: 0 0 8px rgba(255, 204, 51, 0.7), 0 0 18px rgba(255, 204, 51, 0.35);
  }

  .svc-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 2rem;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.45s ease,
      transform 0.35s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .svc-card.svc-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .svc-card.svc-visible:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 204, 51, 0.35);
    box-shadow: 0 8px 32px rgba(255, 204, 51, 0.12);
  }

  .svc-icon {
    color: #FFCC33;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .svc-card.svc-visible:hover .svc-icon {
    animation: svc-bounce 0.45s ease;
  }

  @keyframes svc-bounce {
    0%   { transform: scale(1)    translateY(0); }
    40%  { transform: scale(1.2)  translateY(-5px); }
    70%  { transform: scale(1.05) translateY(-2px); }
    100% { transform: scale(1)    translateY(0); }
  }
</style>
